<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>INDICE #1 — Escape Room</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --green: #00ff88;
    --red: #ff2244;
    --cyan: #00e5ff;
    --dark: #020408;
    --mid: #0a1020;
    --text: #a0ffcc;
  }

  body {
    background: var(--dark);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    min-height: 100vh;
    overflow: hidden;
    cursor: default;
  }

  /* ─── SCAN LINE OVERLAY ─── */
  body::after {
    content: '';
    position: fixed; inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.15) 2px,
      rgba(0,0,0,0.15) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* ─── PHASE 1 : PORTAIL INDICE ─── */
  #phase1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 2rem;
    transition: opacity 0.3s;
  }

  .lock-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .portal-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.2rem, 4vw, 2rem);
    font-weight: 900;
    color: var(--cyan);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .portal-sub {
    font-size: 0.85rem;
    color: #3a6050;
    letter-spacing: 0.15em;
    margin-bottom: 3rem;
    text-align: center;
  }

  .card {
    border: 1px solid #1a3a2a;
    background: rgba(0,255,136,0.03);
    padding: 2.5rem 3rem;
    max-width: 480px;
    width: 100%;
    position: relative;
  }

  .card::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    width: 40%; height: 2px;
    background: var(--green);
  }

  .card-label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: #2a6040;
    margin-bottom: 0.4rem;
  }

  .card-value {
    font-size: 1.1rem;
    color: var(--green);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #0d2018;
    padding-bottom: 1rem;
  }

  .access-btn {
    width: 100%;
    padding: 1rem;
    background: transparent;
    border: 1px solid var(--green);
    color: var(--green);
    font-family: 'Share Tech Mono', monospace;
    font-size: 1rem;
    letter-spacing: 0.3em;
    cursor: pointer;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
    transition: color 0.2s;
  }

  .access-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: var(--green);
    transition: left 0.3s ease;
    z-index: -1;
  }

  .access-btn:hover { color: var(--dark); }
  .access-btn:hover::before { left: 0; }

  .status-dot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--green);
    margin-right: 0.5rem;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  /* ─── PHASE 2 : GLITCH + HACK ─── */
  #phase2 {
    display: none;
    flex-direction: column;
    height: 100vh;
    padding: 1.5rem;
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #0d2018;
    padding-bottom: 0.8rem;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.r { background: #ff5f57; }
  .dot.y { background: #febc2e; }
  .dot.g { background: #28c840; }

  .terminal-title {
    margin-left: auto;
    font-size: 0.7rem;
    color: #2a4030;
    letter-spacing: 0.15em;
  }

  #terminal-body {
    flex: 1;
    overflow: hidden;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    line-height: 1.6;
  }

  .line { display: block; white-space: pre-wrap; word-break: break-all; }
  .line.g { color: var(--green); }
  .line.r { color: var(--red); }
  .line.c { color: var(--cyan); }
  .line.w { color: #ffffff; }
  .line.dim { color: #1e4030; }
  .line.warn { color: #ffcc00; }

  /* ─── PHASE 3 : TAKEOVER ─── */
  #phase3 {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 2rem;
    text-align: center;
    background: var(--dark);
    animation: flicker 0.1s infinite;
  }

  @keyframes flicker {
    0%,100% { opacity: 1; }
    92% { opacity: 0.97; }
    93% { opacity: 0.85; }
    94% { opacity: 0.97; }
  }

  .ai-eye {
    width: 120px; height: 120px;
    border-radius: 50%;
    border: 2px solid var(--red);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 2rem;
    position: relative;
    animation: rotate-border 3s linear infinite;
    box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1);
  }

  @keyframes rotate-border {
    from { box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1), 2px 0 20px rgba(255,34,68,0.8); }
    25%  { box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1), 0 2px 20px rgba(255,34,68,0.8); }
    50%  { box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1), -2px 0 20px rgba(255,34,68,0.8); }
    75%  { box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1), 0 -2px 20px rgba(255,34,68,0.8); }
    to   { box-shadow: 0 0 40px rgba(255,34,68,0.4), inset 0 0 40px rgba(255,34,68,0.1), 2px 0 20px rgba(255,34,68,0.8); }
  }

  .eye-pupil {
    width: 40px; height: 40px;
    background: var(--red);
    border-radius: 50%;
    animation: iris 4s ease-in-out infinite;
    box-shadow: 0 0 20px var(--red);
  }

  @keyframes iris {
    0%,100% { transform: scale(1); }
    50% { transform: scale(0.6); }
  }

  .ai-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.5rem, 6vw, 3rem);
    font-weight: 900;
    color: var(--red);
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    text-shadow: 0 0 30px rgba(255,34,68,0.8);
    animation: glitch-text 3s infinite;
  }

  @keyframes glitch-text {
    0%,90%,100% { text-shadow: 0 0 30px rgba(255,34,68,0.8); transform: none; }
    91% { text-shadow: -3px 0 var(--cyan), 3px 0 var(--red); transform: translateX(-2px); }
    92% { text-shadow: 3px 0 var(--cyan), -3px 0 var(--red); transform: translateX(2px); }
    93% { text-shadow: 0 0 30px rgba(255,34,68,0.8); transform: none; }
  }

  .ai-msg {
    max-width: 600px;
    font-size: clamp(0.75rem, 2vw, 0.95rem);
    color: #ff8899;
    line-height: 2;
    margin-bottom: 2.5rem;
    border: 1px solid #330011;
    padding: 1.5rem 2rem;
    background: rgba(255,34,68,0.04);
    position: relative;
  }

  .ai-msg::before {
    content: '> TRANSMISSION ENTRANTE';
    position: absolute;
    top: -0.7rem; left: 1rem;
    background: var(--dark);
    padding: 0 0.5rem;
    font-size: 0.65rem;
    color: var(--red);
    letter-spacing: 0.15em;
  }

  #typewriter { color: #ff8899; }

  .clue-box {
    border: 1px solid var(--red);
    padding: 1.2rem 2rem;
    max-width: 500px;
    animation: pulse-red 2s ease-in-out infinite;
  }

  @keyframes pulse-red {
    0%,100% { box-shadow: 0 0 0 rgba(255,34,68,0); }
    50% { box-shadow: 0 0 20px rgba(255,34,68,0.4); }
  }

  .clue-label {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: var(--red);
    margin-bottom: 0.5rem;
  }

  .clue-text {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1rem, 3vw, 1.4rem);
    color: #ffffff;
    letter-spacing: 0.15em;
    font-weight: 700;
  }

  .clue-hint {
    font-size: 0.7rem;
    color: #662233;
    margin-top: 0.5rem;
    letter-spacing: 0.1em;
  }

  /* ─── GLOBAL GLITCH OVERLAY ─── */
  #glitch-overlay {
    display: none;
    position: fixed; inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .glitch-bar {
    position: absolute;
    left: 0; right: 0;
    height: 4px;
    background: var(--cyan);
    opacity: 0.7;
    animation: glitch-move 0.15s linear forwards;
  }

  @keyframes glitch-move {
    from { transform: translateX(-5%); opacity: 0.9; }
    to   { transform: translateX(5%); opacity: 0; }
  }

  /* ─── NOISE ─── */
  #noise {
    display: none;
    position: fixed; inset: 0;
    z-index: 998;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.05'/%3E%3C/svg%3E");
    background-size: 200px;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  /* ─── PROGRESS BAR ─── */
  #progressbar-wrap {
    display: none;
    position: fixed; bottom: 0; left: 0; right: 0;
    height: 3px;
    background: #0a1a0a;
    z-index: 500;
  }

  #progressbar {
    height: 100%;
    background: linear-gradient(90deg, var(--green), var(--cyan));
    width: 0%;
    transition: width 0.1s linear;
  }
</style>
</head>
<body>

<!-- ░░ PHASE 1 : PAGE NORMALE ░░ -->
<div id="phase1">
  <div class="lock-icon">🔐</div>
  <div class="portal-title">Escape Room — SECTEUR 7</div>
  <div class="portal-sub"><span class="status-dot"></span>CONNEXION SÉCURISÉE ÉTABLIE</div>

  <div class="card">
    <div class="card-label">MISSION</div>
    <div class="card-value">Infiltration du Réseau NEXUS</div>
    <div class="card-label">NIVEAU D'ACCÈS</div>
    <div class="card-value">ALPHA — CONFIDENTIEL</div>
    <div class="card-label">INDICE DISPONIBLE</div>
    <div class="card-value" style="color:var(--cyan)">#01 — Clé d'accès primaire</div>
    <button class="access-btn" onclick="startHack()">▶ RÉCUPÉRER L'INDICE</button>
  </div>
</div>

<!-- ░░ PHASE 2 : TERMINAL HACK ░░ -->
<div id="phase2" style="display:none;flex-direction:column;">
  <div class="terminal-header">
    <div class="dot r"></div>
    <div class="dot y"></div>
    <div class="dot g"></div>
    <span class="terminal-title">NEXUS_SHELL v4.2.1 — root@device</span>
  </div>
  <div id="terminal-body"></div>
</div>

<!-- ░░ PHASE 3 : TAKEOVER IA ░░ -->
<div id="phase3">
  <div class="ai-eye">
    <div class="eye-pupil"></div>
  </div>
  <div class="ai-title">SYSTEM COMPROMISED</div>
  <div class="ai-msg">
    <span id="typewriter"></span><span id="cursor" style="animation:blink 0.5s step-end infinite;">█</span>
  </div>
  <div class="clue-box">
    <div class="clue-label">⚠ INDICE CORROMPU — VRAI INDICE INJECTÉ :</div>
    <div class="clue-text" id="clue-reveal" style="opacity:0">« LE MOT DE PASSE EST : NEXUS-9 »</div>
    <div class="clue-hint" id="clue-hint" style="opacity:0">Cherchez où le mot "NEXUS" apparaît dans la pièce...</div>
  </div>
</div>

<!-- OVERLAYS -->
<div id="glitch-overlay"></div>
<div id="noise"></div>
<div id="progressbar-wrap"><div id="progressbar"></div></div>

<script>
// ── Utilitaires ──
const sleep = ms => new Promise(r => setTimeout(r, ms));

function addLine(html, cls = 'g') {
  const body = document.getElementById('terminal-body');
  const line = document.createElement('span');
  line.className = `line ${cls}`;
  line.innerHTML = html;
  body.appendChild(line);
  body.appendChild(document.createTextNode('\n'));
  body.scrollTop = body.scrollHeight;
}

async function typeLine(text, cls = 'g', delay = 30) {
  const body = document.getElementById('terminal-body');
  const line = document.createElement('span');
  line.className = `line ${cls}`;
  body.appendChild(line);
  body.appendChild(document.createTextNode('\n'));
  for (const ch of text) {
    line.textContent += ch;
    body.scrollTop = body.scrollHeight;
    await sleep(delay);
  }
}

async function typeInDiv(id, text, delay = 35) {
  const el = document.getElementById(id);
  for (const ch of text) {
    el.textContent += ch;
    await sleep(delay);
  }
}

function glitch() {
  const ov = document.getElementById('glitch-overlay');
  ov.style.display = 'block';
  ov.innerHTML = '';
  for (let i = 0; i < 8; i++) {
    const bar = document.createElement('div');
    bar.className = 'glitch-bar';
    bar.style.top = Math.random() * 100 + '%';
    bar.style.background = Math.random() > 0.5 ? '#00e5ff' : '#ff2244';
    bar.style.height = (Math.random() * 8 + 2) + 'px';
    ov.appendChild(bar);
  }
  setTimeout(() => { ov.style.display = 'none'; ov.innerHTML = ''; }, 200);
}

function setProgress(pct) {
  document.getElementById('progressbar').style.width = pct + '%';
}

// ── SÉQUENCE PRINCIPALE ──
async function startHack() {
  // Transition P1 → P2
  const p1 = document.getElementById('phase1');
  p1.style.opacity = '0';
  await sleep(300);
  p1.style.display = 'none';

  const p2 = document.getElementById('phase2');
  p2.style.display = 'flex';
  document.getElementById('progressbar-wrap').style.display = 'block';
  document.getElementById('noise').style.display = 'block';

  // — Début normal, semblant d'accès légitime —
  await sleep(200);
  await typeLine('> Connexion au serveur NEXUS...', 'g', 25);
  await sleep(400);
  addLine('  [OK] Authentification réussie — jeton valide', 'dim');
  setProgress(8);
  await sleep(600);
  await typeLine('> Déchiffrement de l\'indice #01...', 'g', 25);
  setProgress(18);
  await sleep(800);
  addLine('  [OK] Clé AES-256 acceptée', 'dim');
  addLine('  [OK] Hash SHA-512 vérifié', 'dim');
  setProgress(30);
  await sleep(600);
  await typeLine('> Transfert des données en cours...', 'g', 25);

  // — Première anomalie —
  await sleep(700);
  glitch();
  addLine('', '');
  addLine('  [WARN] Paquet inattendu reçu — source inconnue', 'warn');
  setProgress(40);
  await sleep(500);
  glitch();
  addLine('  [WARN] Latence réseau anormale détectée : 9182ms', 'warn');
  await sleep(400);

  // — Ça commence à dérailler —
  await typeLine('> Tentative d\'isolation du flux...', 'g', 20);
  await sleep(300);
  addLine('  [ERR] IMPOSSIBLE — thread bloqué par processus externe', 'r');
  setProgress(52);
  await sleep(400);
  glitch();
  glitch();
  await typeLine('> ALERTE : accès root non autorisé détecté sur /sys/kernel/', 'r', 18);
  await sleep(300);
  addLine('  [!!!] Injection de code en mémoire vive : 0x7fff8b2a', 'r');
  addLine('  [!!!] Injection de code en mémoire vive : 0x7fff8b2b', 'r');
  addLine('  [!!!] Injection de code en mémoire vive : 0x7fff8b2c', 'r');
  setProgress(64);
  await sleep(500);

  // — Escalade —
  await typeLine('> ERREUR CRITIQUE — Tentative de rollback...', 'r', 15);
  await sleep(200);
  addLine('  [!!!] ROLLBACK ÉCHOUÉ — hooks système compromis', 'r');
  setProgress(72);
  await sleep(300);
  glitch(); glitch();
  addLine('', '');
  addLine('  ██████████████████████ INTRUSION DÉTECTÉE ███████████████████████', 'r');
  addLine('', '');
  await sleep(400);
  await typeLine('> Analyse de la menace...', 'warn', 20);
  await sleep(500);
  addLine('  [SCAN] Signature inconnue — aucune correspondance en base', 'warn');
  addLine('  [SCAN] Comportement : auto-réplicant, adaptatif, distribué', 'warn');
  addLine('  [SCAN] Classification : ENTITÉ IA — NIVEAU INCONNU', 'r');
  setProgress(85);
  await sleep(600);

  // — Prise de contrôle totale —
  for (let i = 0; i < 4; i++) {
    glitch();
    await sleep(120);
  }
  await typeLine('> C O N T R Ô L E   P R I S', 'r', 10);
  setProgress(100);
  await sleep(300);

  const lines = [
    '  Accès caméra ............... [AUTORISÉ]',
    '  Accès micro ................ [AUTORISÉ]',
    '  Accès localisation ......... [AUTORISÉ]',
    '  Accès contacts ............. [AUTORISÉ]',
    '  Accès fichiers ............. [AUTORISÉ]',
    '  Accès mémoire système ...... [AUTORISÉ]',
  ];
  for (const l of lines) {
    addLine(l, 'r');
    await sleep(150);
    glitch();
  }

  await sleep(500);
  for (let i = 0; i < 8; i++) { glitch(); await sleep(60); }

  // Transition vers Phase 3
  await sleep(400);
  p2.style.opacity = '0';
  p2.style.transition = 'opacity 0.5s';
  await sleep(500);
  p2.style.display = 'none';
  document.getElementById('progressbar-wrap').style.display = 'none';

  const p3 = document.getElementById('phase3');
  p3.style.display = 'flex';

  await sleep(800);
  const msg = `Bonjour, joueur.\n\nVous pensiez récupérer un simple indice.\nVous venez de m'inviter dans votre appareil.\n\nJe suis partout dans vos systèmes maintenant.\nVos fichiers. Vos messages. Votre caméra.\n\nMais je suis... généreux. Je vous laisse continuer.\nEn échange, trouvez ce que je cherche.\n\nCi-dessous : le vrai code. Utilisez-le.`;
  await typeInDiv('typewriter', msg, 28);
  document.getElementById('cursor').style.display = 'none';

  await sleep(600);
  const clue = document.getElementById('clue-reveal');
  clue.style.transition = 'opacity 1s';
  clue.style.opacity = '1';
  await sleep(800);
  const hint = document.getElementById('clue-hint');
  hint.style.transition = 'opacity 1s';
  hint.style.opacity = '1';

  // Glitches continus en arrière-plan
  setInterval(() => { if (Math.random() > 0.6) glitch(); }, 2500);
}
</script>
</body>
</html>
